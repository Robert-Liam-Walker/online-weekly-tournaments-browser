# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://owt:owt@localhost:5432/owtbrowser?schema=public
JWT_SECRET=change-me-to-64-random-chars
PORT=3001
CORS_ORIGINS=http://localhost:5173
# stub | wasm (falls back to stub when engine.wasm is not built)
ENGINE_KIND=stub
# Optional bootstrap admin, created or promoted at boot.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
